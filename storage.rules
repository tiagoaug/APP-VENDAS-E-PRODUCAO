rules_version = '2';

// Fotos de produto — únicas coisas guardadas no Firebase Storage neste app (tudo mais continua
// no Firestore). Ficam em users/{uid}/productPhotos/{arquivo} e são PÚBLICAS pra leitura de
// propósito: o Catálogo Público (src/publicCatalog/, ver pedido.html) é uma página sem login
// que precisa exibir essas fotos pra qualquer visitante com o link — não tem informação sensível
// numa foto de produto, então abrir leitura aqui não é um risco (diferente do Firestore, onde
// cada coleção continua isolada por dono). Escrita só pelo próprio dono autenticado.
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{userId}/productPhotos/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
