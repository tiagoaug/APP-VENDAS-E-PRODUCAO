require_relative '../../node_modules/@capacitor/ios/scripts/pods_helpers'

platform :ios, '15.5'
use_frameworks!

# workaround to avoid Xcode caching of Pods that requires
# Product -> Clean Build Folder after new Cordova plugins installed
# Requires CocoaPods 1.6 or newer
install! 'cocoapods', :disable_input_output_paths => true

# ATENCAO PARA QUEM FOR EDITAR: nunca escreva, nem em comentario, a palavra "def" logo antes
# do nome da funcao de pods do Capacitor (a que vem logo abaixo) - o "npx cap sync ios" acha
# esse bloco com um regex simples que nao entende comentario Ruby (ver
# node_modules/@capacitor/cli/dist/ios/update.js, updatePodfile()) e reescreve TUDO a partir
# dali. Foi exatamente isso que quebrou o build: um comentario anterior citava essa mesma
# combinacao de palavras, o regex casou a partir do comentario em vez da funcao de verdade, e
# corrompeu o arquivo inteiro (erro "unexpected end" no Codemagic).
#
# O bloco logo abaixo e reescrito automaticamente a cada sync com uma lista simples de
# pod + path, SEM suporte a subspecs - foi por isso que declarar CapacitorFirebaseAuthentication
# com subspecs => ['Google'] ali dentro nunca sobrevivia (o "Sincronizar Capacitor iOS" do
# Codemagic roda ANTES do "Instalar CocoaPods", apagando a edicao sem nenhum aviso). Sem o
# subspec Google, FirebaseAuthentication.signInWithGoogle() compila como uma funcao Swift
# VAZIA (o corpo real fica atras de "#if RGCFA_INCLUDE_GOOGLE", so definida por esse subspec -
# ver .../authentication/ios/Plugin/Handlers/GoogleAuthProviderHandler.swift e
# CapacitorFirebaseAuthentication.podspec) - a Promise do lado JS nunca resolve nem rejeita,
# trava ate o timeout de 15s do resolveAuthCall ("Tempo esgotado ao conectar"). Sign in with
# Apple nao depende de subspec, por isso sempre funcionou normalmente.
#
# A correcao mora FORA deste bloco (ver target 'App' logo abaixo) - essa parte sobrevive ao
# sync normalmente, sem risco de ser apagada.
def capacitor_pods
  pod 'Capacitor', :path => '../../node_modules/@capacitor/ios'
  pod 'CapacitorCordova', :path => '../../node_modules/@capacitor/ios'
  pod 'AparajitaCapacitorBiometricAuth', :path => '../../node_modules/@aparajita/capacitor-biometric-auth'
  pod 'CapacitorCommunityContacts', :path => '../../node_modules/@capacitor-community/contacts'
  pod 'CapacitorCommunitySpeechRecognition', :path => '../../node_modules/@capacitor-community/speech-recognition'
  pod 'CapacitorFirebaseAuthentication', :path => '../../node_modules/@capacitor-firebase/authentication'
  pod 'CapacitorMlkitBarcodeScanning', :path => '../../node_modules/@capacitor-mlkit/barcode-scanning'
  pod 'CapacitorMlkitTextRecognition', :path => '../../node_modules/@capacitor-mlkit/text-recognition'
  pod 'CapacitorCamera', :path => '../../node_modules/@capacitor/camera'
  pod 'CapacitorClipboard', :path => '../../node_modules/@capacitor/clipboard'
  pod 'CapacitorFilesystem', :path => '../../node_modules/@capacitor/filesystem'
  pod 'CapacitorGeolocation', :path => '../../node_modules/@capacitor/geolocation'
  pod 'CapacitorLocalNotifications', :path => '../../node_modules/@capacitor/local-notifications'
  pod 'CapacitorPushNotifications', :path => '../../node_modules/@capacitor/push-notifications'
  pod 'CapacitorShare', :path => '../../node_modules/@capacitor/share'
  pod 'CapawesomeCapacitorFilePicker', :path => '../../node_modules/@capawesome/capacitor-file-picker'
  pod 'CapgoCapacitorNativeBiometric', :path => '../../node_modules/@capgo/capacitor-native-biometric'
  pod 'CapgoCapacitorPrinter', :path => '../../node_modules/@capgo/capacitor-printer'
end

target 'App' do
  capacitor_pods
  # Fica FORA do bloco acima de proposito (ver aviso no topo do arquivo) - esta linha sobrevive
  # ao sync. So declara o subspec ADICIONAL "Google"; a declaracao padrao ("Lite", vazia)
  # continua vindo do bloco acima - CocoaPods aceita multiplas linhas pod pro mesmo nome com
  # subspecs diferentes no mesmo target, mesclando os requisitos.
  pod 'CapacitorFirebaseAuthentication/Google', :path => '../../node_modules/@capacitor-firebase/authentication'
end

post_install do |installer|
  assertDeploymentTarget(installer)
end
