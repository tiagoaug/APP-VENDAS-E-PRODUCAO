require_relative '../../node_modules/@capacitor/ios/scripts/pods_helpers'

platform :ios, '15.5'
use_frameworks!

# workaround to avoid Xcode caching of Pods that requires
# Product -> Clean Build Folder after new Cordova plugins installed
# Requires CocoaPods 1.6 or newer
install! 'cocoapods', :disable_input_output_paths => true

# ATENÇÃO: tudo dentro de `def capacitor_pods ... end` é REESCRITO automaticamente pelo
# `npx cap sync ios` toda vez que roda (ver node_modules/@capacitor/cli/dist/ios/update.js,
# updatePodfile() — o regex `/(def capacitor_pods)[\s\S]+?(\nend)/` substitui esse bloco
# inteiro por uma lista gerada de `pod 'Nome', :path => '...'` simples, SEM subspecs). Foi
# exatamente por isso que adicionar `:subspecs => ['Google']` direto na linha do
# CapacitorFirebaseAuthentication aqui dentro nunca funcionava: o "Sincronizar Capacitor iOS"
# do Codemagic roda ANTES do "Instalar CocoaPods" e apagava essa edição a cada build, sem
# nenhum erro visível — o pod install seguinte sempre resolvia o subspec "Lite" (padrão), que
# compila FirebaseAuthentication.signInWithGoogle() como uma função VAZIA (todo o corpo Swift
# fica atrás de "#if RGCFA_INCLUDE_GOOGLE", só definida pelo subspec "Google" — ver
# node_modules/@capacitor-firebase/authentication/ios/Plugin/Handlers/GoogleAuthProviderHandler.swift
# e CapacitorFirebaseAuthentication.podspec). A Promise do lado JS nunca resolvia nem
# rejeitava — travava até o timeout de 15s do resolveAuthCall ("Tempo esgotado ao conectar"),
# mesmo com skipNativeAuth:true já correto. Sign in with Apple não depende de subspec (não usa
# SDK de terceiros), por isso sempre funcionou normalmente enquanto Google travava.
def capacitor_pods
  pod 'Capacitor', :path => '../../node_modules/@capacitor/ios'
  pod 'CapacitorCordova', :path => '../../node_modules/@capacitor/ios'
  pod 'AparajitaCapacitorBiometricAuth', :path => '../../node_modules/@aparajita/capacitor-biometric-auth'
  pod 'CapacitorCommunityContacts', :path => '../../node_modules/@capacitor-community/contacts'
  pod 'CapacitorCommunitySpeechRecognition', :path => '../../node_modules/@capacitor-community/speech-recognition'
  pod 'CapacitorFirebaseAuthentication', :path => '../../node_modules/@capacitor-firebase/authentication'
  pod 'CapacitorMlkitBarcodeScanning', :path => '../../node_modules/@capacitor-mlkit/barcode-scanning'
  pod 'CapacitorMlkitTextRecognition', :path => '../../node_modules/@capacitor-mlkit/text-recognition'
  pod 'CapacitorCamera', :path => '../../node_modules/@capacitor/camera'
  pod 'CapacitorClipboard', :path => '../../node_modules/@capacitor/clipboard'
  pod 'CapacitorFilesystem', :path => '../../node_modules/@capacitor/filesystem'
  pod 'CapacitorGeolocation', :path => '../../node_modules/@capacitor/geolocation'
  pod 'CapacitorLocalNotifications', :path => '../../node_modules/@capacitor/local-notifications'
  pod 'CapacitorPushNotifications', :path => '../../node_modules/@capacitor/push-notifications'
  pod 'CapacitorShare', :path => '../../node_modules/@capacitor/share'
  pod 'CapawesomeCapacitorFilePicker', :path => '../../node_modules/@capawesome/capacitor-file-picker'
  pod 'CapgoCapacitorNativeBiometric', :path => '../../node_modules/@capgo/capacitor-native-biometric'
end

target 'App' do
  capacitor_pods
  # Fica FORA de capacitor_pods de propósito (ver aviso grande no topo do arquivo) — essa linha
  # sobrevive ao `cap sync ios`. Só declara o subspec ADICIONAL "Google"; a declaração "Lite"
  # (padrão, vazia) continua vindo de capacitor_pods acima — CocoaPods aceita múltiplas linhas
  # `pod` pro mesmo nome com subspecs diferentes no mesmo target, mesclando os requisitos.
  pod 'CapacitorFirebaseAuthentication/Google', :path => '../../node_modules/@capacitor-firebase/authentication'
end

post_install do |installer|
  assertDeploymentTarget(installer)
end
