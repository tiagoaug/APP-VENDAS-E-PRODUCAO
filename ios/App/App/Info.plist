<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>APP VENDAS E PRODUCAO</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>

	<!-- Câmera — escaneamento de código de barras/QR Code (mesmo motivo do Android, ver
	     AndroidManifest.xml). -->
	<key>NSCameraUsageDescription</key>
	<string>Necessário para escanear códigos de barras e QR Code.</string>

	<!-- Galeria — seleção de imagens (fotos de produtos, importação de arquivos). -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Necessário para selecionar imagens da galeria.</string>

	<!-- Galeria (salvar) — "Salvar na Galeria" em Etiquetas/Central de Compartilhamento e fotos
	     tiradas pela câmera. Sem esta chave o iOS bloqueia inclusive a própria câmera com o erro
	     "Camera will not function without it", mesmo só lendo a galeria. -->
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Necessário para salvar imagens e etiquetas geradas na galeria do aparelho.</string>

	<!-- Face ID — login rápido na tela "Quem é Você?" (ver CollaboratorGateView). -->
	<key>NSFaceIDUsageDescription</key>
	<string>Usado para confirmar sua identidade e entrar mais rápido, sem digitar o PIN.</string>

	<!-- Contatos — importação/sincronização de clientes e fornecedores. -->
	<key>NSContactsUsageDescription</key>
	<string>Necessário para importar e sincronizar contatos de clientes e fornecedores.</string>

	<!-- Microfone + reconhecimento de voz — entrada de voz no assistente de IA. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Necessário para entrada de voz no assistente de IA.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Necessário para reconhecimento de voz no assistente de IA.</string>

	<!-- Localização — módulo Entregas: posição do motorista em tempo real só enquanto a tela de
	     entrega está aberta (mesmo escopo do Android, sem rastreio em segundo plano). -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Necessário para mostrar a posição do motorista em tempo real durante uma entrega.</string>

	<!-- Rede local — sem isso o iOS bloqueia silenciosamente a busca por impressoras AirPrint
	     na Wi-Fi (UIPrintInteractionController usa Bonjour/mDNS pra descobrir impressoras, e
	     desde o iOS 14 isso exige essa permissão declarada); a folha de impressão abre
	     normalmente, mas mostra "No AirPrint Printers Found" mesmo com a impressora ligada
	     na mesma rede e funcionando via apps do sistema (Fotos, Arquivos), que já têm esse
	     acesso liberado por padrão. _ipp._tcp/_ipps._tcp são os serviços mDNS que o AirPrint
	     anuncia. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Necessário para encontrar impressoras disponíveis na sua rede Wi-Fi.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_ipp._tcp</string>
		<string>_ipps._tcp</string>
	</array>

	<!-- Impressão IPP direto por IP — fetch() puro em http:// (porta 631) pra impressoras que
	     falam IPP mas não têm certificação AirPrint (ex.: alguns Epson que só aparecem no
	     Android). ATS bloqueia HTTP puro por padrão; NSAllowsLocalNetworking libera só pra
	     endereços de rede local (192.168.x, 10.x etc.), sem desligar ATS pro resto do app. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>

	<!-- Login com Google (FirebaseAuthentication, provider "google.com" em capacitor.config.ts) —
	     REVERSED_CLIENT_ID do GoogleService-Info.plist, exigido pro fluxo de retorno do login. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.934569927713-n632i8ti3f4hbqij9tl6lui4q1gks6vk</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
