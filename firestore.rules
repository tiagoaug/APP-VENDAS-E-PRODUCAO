rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Global Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isEmailVerified() { return request.auth.token.email_verified == true; }
    function isValidId(id) { return id is string && id.size() <= 128; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // --- Entity Validations ---

    function isValidProductData(data) {
      return (data.reference is string && data.reference.size() <= 50)
        && (data.name is string && data.name.size() <= 100)
        && (data.supplierId is string && data.supplierId.size() <= 128)
        && (data.defaultGridId is string && data.defaultGridId.size() <= 128)
        && (data.variations is list && data.variations.size() <= 50)
        && (data.createdAt is number);
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['reference', 'name', 'supplierId', 'defaultGridId', 'variations', 'createdAt'])
        && isValidProductData(data);
    }

    function isValidCategory(data) {
      return data.keys().hasAll(['name', 'color', 'type'])
        && data.name is string && data.name.size() <= 50
        && data.color is string && data.color.size() <= 30
        && data.type in ['PRODUCT', 'EXPENSE', 'REVENUE'];
    }

    function isValidGrid(data) {
      return data.keys().hasAll(['name', 'configuration'])
        && data.name is string && data.name.size() <= 50
        && data.configuration is map;
    }

    function isValidPerson(data) {
      return data.keys().hasAll(['name', 'isCustomer', 'isSupplier'])
        && data.name is string && data.name.size() <= 100
        && data.isCustomer is bool
        && data.isSupplier is bool;
    }

    function isValidSale(data) {
      return data.keys().hasAll(['orderNumber', 'date', 'items', 'subtotal', 'discount', 'total', 'status', 'paymentTerm'])
        && data.orderNumber is string && data.orderNumber.size() <= 20
        && data.date is number
        && data.items is list
        && data.subtotal is number && data.subtotal >= 0
        && data.discount is number && data.discount >= 0
        && data.total is number && data.total >= 0
        && data.status in ['QUOTE', 'SALE', 'CANCELLED']
        && data.paymentTerm in ['CASH', 'INSTALLMENTS'];
    }

    function isValidTransaction(data) {
      return data.type in ['INCOME', 'EXPENSE']
        && data.amount is number
        && data.date is number
        && data.description is string
        && data.status in ['PENDING', 'COMPLETED'];
    }

    function isValidAccount(data) {
      return data.name is string
        && data.balance is number;
    }

    function isValidColorValue(data) {
      return data.keys().hasAll(['name', 'hex'])
        && data.name is string && data.name.size() <= 30
        && data.hex is string && data.hex.matches('^#[0-9a-fA-F]{6}$');
    }

    function isValidPaymentMethod(data) {
      return data.keys().hasAll(['name', 'icon'])
        && data.name is string && data.name.size() <= 30
        && data.icon is string && data.icon.size() <= 30;
    }

    function isValidPurchase(data) {
      // Basic validation for now, adjust based on actual data
      return data.keys().hasAll(['supplierId', 'date', 'type'])
        && data.supplierId is string && data.supplierId.size() <= 128
        && data.date is number
        && data.type is string;
    }

    // Link de Pedido (catálogo público) — só o DONO autenticado cria/gerencia isto; o
    // visitante anônimo do link nunca toca o Firestore direto (só via Cloud Functions com
    // Admin SDK, que ignora estas regras — ver functions/src/catalog/publicCatalog.ts).
    function isValidCatalogLink(data) {
      return data.keys().hasAll(['personId', 'token', 'isActive', 'createdAt'])
        && data.personId is string && data.personId.size() <= 128
        && data.token is string && data.token.size() >= 8 && data.token.size() <= 128
        && data.isActive is bool
        && data.createdAt is number;
    }

    function isValidCatalogRequest(data) {
      return data.keys().hasAll(['linkId', 'personId', 'status', 'items'])
        && data.linkId is string && data.linkId.size() <= 128
        && data.personId is string && data.personId.size() <= 128
        && data.status in ['PENDING', 'IMPORTED', 'DISMISSED']
        && data.items is list && data.items.size() <= 30;
    }

    // Perfil de Envio de Catálogo — seleção de produtos salva com nome (ver CatalogProfile em
    // src/types.ts); só o dono lê/escreve, nunca tocado pelo Cloud Function público.
    function isValidCatalogProfile(data) {
      return data.keys().hasAll(['name', 'productIds', 'createdAt'])
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && data.productIds is list && data.productIds.size() <= 500
        && data.createdAt is number;
    }

    // --- Match Rules ---

    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Client ID/Secret do app Bling da própria empresa + tokens de acesso — só a Admin
      // SDK (Cloud Functions) pode ler/escrever aqui, nunca o client. Isolado explicitamente
      // por documentação; a exclusão real acontece na condição da regra coringa abaixo,
      // porque no Firestore uma regra mais específica NÃO sobrescreve uma mais ampla que
      // também bata no mesmo caminho — se qualquer regra aplicável permitir, o acesso é
      // permitido. Por isso a regra coringa precisa excluir este caminho na própria condição.
      match /blingIntegration/{document=**} {
        allow read, write: if false;
      }

      // Validação extra (defesa em profundidade) pro Link de Pedido — excluídas da regra
      // coringa abaixo (mesmo mecanismo do blingIntegration) só pra impor o formato do
      // documento; o dono continua podendo ler/escrever normalmente, só que validado.
      match /catalogLinks/{linkId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidCatalogLink(incoming());
      }

      match /catalogRequests/{requestId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) && isValidCatalogRequest(incoming());
        allow update: if isOwner(userId) && incoming().status in ['PENDING', 'IMPORTED', 'DISMISSED'];
      }

      match /catalogProfiles/{profileId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidCatalogProfile(incoming());
      }

      match /{collection}/{document=**} {
        allow read, write: if isOwner(userId)
          && collection != 'blingIntegration'
          && collection != 'catalogLinks'
          && collection != 'catalogRequests'
          && collection != 'catalogProfiles';
      }
    }

    // Índice global uid -> uid, usado pelo webhook público do Bling (chega sem contexto de
    // usuário) pra confirmar que aquele uid embutido na URL do webhook é de uma conta
    // realmente conectada. Só Admin SDK.
    match /blingWebhookIndex/{uid} {
      allow read, write: if false;
    }

    // Nonces temporários do fluxo de OAuth (state -> uid), consumidos pelo callback
    // público do Bling. Só Admin SDK.
    match /blingAuthNonces/{nonce} {
      allow read, write: if false;
    }

    // Modelos de categoria compartilhados ENTRE CONTAS — pool de sugestões que qualquer
    // conta nova pode tocar pra adicionar às próprias categorias (ex.: no Assistente de
    // Configuração Inicial). Única coleção fora de users/{uid} com leitura liberada pra
    // qualquer usuário logado; escrita segue dono-do-documento (createdBy), não dono-da-conta.
    match /categoryTemplates/{templateId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && incoming().createdBy == request.auth.uid
        && incoming().name is string && incoming().name.size() > 0 && incoming().name.size() <= 60
        && incoming().type is string
        && incoming().createdAt is number;
      allow update, delete: if isSignedIn() && existing().createdBy == request.auth.uid;
    }

    // Modelos de cor compartilhados ENTRE CONTAS — mesmo desenho de categoryTemplates acima.
    match /colorTemplates/{templateId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && incoming().createdBy == request.auth.uid
        && incoming().name is string && incoming().name.size() > 0 && incoming().name.size() <= 60
        && incoming().createdAt is number;
      allow update, delete: if isSignedIn() && existing().createdBy == request.auth.uid;
    }

    // Modelos de grade compartilhados ENTRE CONTAS — mesmo desenho de categoryTemplates acima.
    match /gridTemplates/{templateId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && incoming().createdBy == request.auth.uid
        && incoming().name is string && incoming().name.size() > 0 && incoming().name.size() <= 60
        && incoming().type is string
        && incoming().createdAt is number;
      allow update, delete: if isSignedIn() && existing().createdBy == request.auth.uid;
    }

    // Modelos de flow tag compartilhados ENTRE CONTAS — mesmo desenho de categoryTemplates acima.
    match /flowTagTemplates/{templateId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && incoming().createdBy == request.auth.uid
        && incoming().name is string && incoming().name.size() > 0 && incoming().name.size() <= 60
        && incoming().createdAt is number;
      allow update, delete: if isSignedIn() && existing().createdBy == request.auth.uid;
    }

    // Modelos de setor compartilhados ENTRE CONTAS — mesmo desenho de categoryTemplates acima.
    match /sectorTemplates/{templateId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && incoming().createdBy == request.auth.uid
        && incoming().name is string && incoming().name.size() > 0 && incoming().name.size() <= 60
        && incoming().createdAt is number;
      allow update, delete: if isSignedIn() && existing().createdBy == request.auth.uid;
    }
  }
}
